    {
      "name": "16 Yaklaşan etkinlikler",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/upcoming",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "upcoming"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "const t = (s) => { const [g, a, y] = s.split(\"-\"); return `${y}-${a}-${g}`; };",
              "const bugun = new Date().toISOString().slice(0, 10);",
              "pm.test(\"Geçmiş tarihli yok\", () => list.forEach((e) => pm.expect(t(e.date) >= bugun).to.be.true));",
              "pm.test(\"Tarihe göre sıralı\", () => list.slice(1).forEach((e, i) => pm.expect(t(e.date) >= t(list[i].date)).to.be.true));"
            ]
          }
        }
      ]
