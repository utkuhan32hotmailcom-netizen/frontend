        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Docker Atölyesi\",\n  \"category\": \"Atölye\",\n  \"date\": \"15-12-2026\",\n  \"capacity\": 30,\n  \"time\": \"14:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 1\",\n  \"description\": \"Konteyner mantığı ve ilk imajını hazırlama.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Tarih GG-AA-YYYY döner\", () => pm.expect(pm.response.json().date).to.eql(\"15-12-2026\"));",
              "// Yeni kaydın _id'si: PATCH ve DELETE bunu kullanır, seed verisi bozulmaz",
              "pm.collectionVariables.set(\"newId\", pm.response.json()._id);"
            ]
          }
